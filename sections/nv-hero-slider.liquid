{% if section.blocks.size > 0 %}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
{% if section.settings.background_image != blank %}
     .section-{{ section.id }}-padding {
        background-image:url('{{ section.settings.background_image | image_url:width:"1900x" }}');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center center;
        background-attachment: unset;
     }
  {%  endif %}
  .section-{{ section.id }}-padding .nv-hero-slider-buttons div {
        width: 100px;
        height: 100px;
        line-height: 0;
        cursor: pointer;
    }

    .section-{{ section.id }}-padding .nv-hero-slider-buttons div img {
        width: 100%;
        height: auto;
        object-fit: contain;
    }

    .section-{{ section.id }}-padding .nv-hero-slider-buttons {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: absolute;
        top: 50%;
        z-index: 1;
        transform: translateY(-50%);
        left: 0;
        right: 0;
    }

   .section-{{ section.id }}-padding .swiper.nv-hero-swiper {
        position: relative;
    }

   .section-{{ section.id }}-padding .image-wrapper {
        line-height: 0;
        padding:0 70px;
        display:block;
    }
   .section-{{ section.id }}-padding .page-full-width .image-wrapper {
        padding:0;
    }
    .section-{{ section.id }}-padding .image-wrapper img {max-width: 100%;width: 100%;height: auto;object-fit: contain;}
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }  
{%- endstyle -%}
<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
    <div class="{% if section.settings.full_width %}page-full-width{% else %}page-width{% endif %}">
      
       <div class="nv-hero-slider-main">
          <nv-hero-slider>
               <div class="swiper nv-hero-swiper">
                  <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                     <div class="swiper-slide nv-hero-swiper-slide">
                        {% if block.settings.image != blank %}
                          {% assign desktop_image_class = '' %}
                          {% if block.settings.image_m != blank %}
                            {% assign desktop_image_class = 'mobile-hide' %}
                          {% endif %}
                          <a class="image-wrapper" href="{{ block.settings.url | default:'#' }}">
                            {% comment %}
                            {{ block.settings.image | image_url: width: '1920x' | image_tag:loading:'lazy',class:desktop_image_class,alt:block.settings.image.alt }}
                            {% if block.settings.image_m != blank %}
                              {{ block.settings.image_m | image_url: width: '1024x' | image_tag:loading:'lazy',class:'desktop-hide',alt:block.settings.image_m.alt }}
                            {% endif %}
                            {% endcomment %}
                             <img src="{{ block.settings.image | image_url }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" alt="{{block.settings.image.alt | escape}}" class="{{ desktop_image_class }}">
                              {% if block.settings.image_m != blank %}
                                <img src="{{ block.settings.image_m | image_url }}" width="{{ block.settings.image_m.width }}" height="{{ block.settings.image_m.height }}" loading="lazy" alt="{{block.settings.image_m.alt | escape}}" class="desktop-hide">
                              {% endif %}
                          </a>
                        {% endif %}
                        
                     </div>
                    {% endfor %}
                  </div>
                  <div class="nv-hero-slider-buttons">
                    <div class="nv-hero-button-prev">
                        <img src="https://cdn.shopify.com/s/files/1/0956/8344/5049/files/Slider_Arrow.png?v=1766427532" loading="lazy">
                    </div>
                    <div class="nv-hero-button-next">
                        <img src="https://cdn.shopify.com/s/files/1/0956/8344/5049/files/Slider_Arrow_Next.png?v=1766427533" loading="lazy">
                    </div>
                  </div>
               </div>
          </nv-hero-slider>
       </div>
       
    </div>
</div>
<script src="{{ 'nv-hero-slider.js' | asset_url }}" defer="defer"></script>
{% endif %}
{% schema %}
{
  "name": "NV:Hero slider",
  "class": "shopify-section nv-hero-slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width?",
      "default":false
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
            
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id":"image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id":"image_m",
          "label": "Mobile Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NV:hero slider"
    }
  ]
}
{% endschema %}
