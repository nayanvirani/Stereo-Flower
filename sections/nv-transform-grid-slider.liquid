
{% if section.blocks.size > 0 %}
  {{ 'nv-transform-grid-slider.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
{% if section.settings.background_image != blank %}
     .section-{{ section.id }}-padding {
        background-image:url('{{ section.settings.background_image | image_url:width:"1900x" }}');
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center center;
        background-attachment: unset;
     }
  {%  endif %}
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }  
  {% if section.settings.container_width > 0 %}
    .section-{{ section.id }}-padding .page-width{
      max-width:{{section.settings.container_width }}px;
    }
  {% endif %}
{%- endstyle -%}
<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
    <div class="{% if section.settings.background_image != blank %}page-width-full{% else %}page-width{% endif %}">
       {% if section.settings.heading != blank %}
        <div class="nv-transform-grid-slider__title title-wrapper center">
            {% if section.settings.section_top_text != blank %}
                <div class="section-top-text">{{section.settings.section_top_text}}</div>
            {% endif %}
            {%- if section.settings.heading != blank -%}
                <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                {{ section.settings.heading | replace:'__BREAKLINE__','<br/>' }}
                </h2>
            {%- endif -%}
            {% if section.settings.content != blank %}
              <div class="nv-transform-grid-content">
                {{ section.settings.content }}
              </div>
            {% endif %}
        </div>
       {% endif %}
       <div class="nv-transform-grid-slider-main">
          <nv-transform-grid-slider data-space="{{section.settings.spacebetween}}" data-desktop="{{section.settings.desktop_grid }}" data-tablet="{{section.settings.tablet_grid}}" data-mobile="{{ section.settings.mobile_grid }}">
               <div class="swiper nv-transform-grid-swiper">
                  <div class="swiper-wrapper">
                    {% for block in section.blocks %}
                     <div class="swiper-slide nv-transform-grid-swiper-slide{% if block.settings.is_uppercase %} uppercase{% endif %}" style="
                      --gradient-background: {{ block.settings.block_background }};
                      --color:{{ block.settings.content_color }};
                      ">
                        {% if block.settings.image != blank %}
                          <div class="image-wrapper">
                            {{ block.settings.image | image_url: width: '800x' | image_tag:loading:'lazy' }}
                          </div>
                        {% endif %}
                        {% if block.settings.title != blank %}
                            <div class="nv-transform-grid-slider-title{% if block.settings.title_center %} center{% endif %}">{{ block.settings.title }}</div>
                        {% endif %}
                        {% if block.settings.subtitle != blank %}
                            <div class="nv-transform-grid-slider-subtitle{% if block.settings.title_center %} center{% endif %}">{{ block.settings.subtitle }}</div>
                        {% endif %}
                        {% if block.settings.content != blank %}
                        <div class="nv-transform-grid-slider-content{% if block.settings.content_center %} center{% endif %}">{{ block.settings.content }}</div>
                        {% endif %}
                     </div>
                    {% endfor %}
                  </div>
                   <div class="swiper-pagination nv-transform-grid-swiper-pagination"></div>
               </div>
          </nv-transform-grid-slider>
       </div>
       
    </div>
</div>
{% endif %}
<script src="{{ 'nv-transform-grid-slider.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "NV:Transform grid slider",
  "class": "shopify-section nv-transform-grid-slider",
  "settings": [
    {
      "type":"number",
      "id":"container_width",
      "label": "Container Width"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "inline_richtext",
      "id": "content",
       "label": "Content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Grid settings"
    },
    {
      "type": "select",
      "id": "desktop_grid",
      "default":"3",
      "label": "Number of item display (Desktop)",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "tablet_grid",
      "default":"2",
      "label": "Number of item display (Tablet)",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_grid",
      "default":"1",
      "label": "Number of item display (Mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
        "type": "range",
        "id": "spacebetween",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Space between of grid",
        "default": 45
    },        
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id":"image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sub Title"
        },
        {
          "type": "checkbox",
          "id": "title_center",
          "label": "Title center?",
          "default":false
        },
        {
          "type": "richtext",
          "id":"content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "content_center",
          "label": "Content center?",
          "default":false
        },
        {
          "type": "checkbox",
          "id":"is_uppercase",
          "label": "All text uppsercase?",
          "default":false
        },
        {
          "type": "color_background",
          "id": "block_background",
          "label": "Background"
        },
        {
          "type": "color",
          "id": "content_color",
          "label": "Content Color",
          "default":"#000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NV:Transform grid slider"
    }
  ]
}
{% endschema %}
