{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.45 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.45 | round: 0 }}px;
  }
  
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
   {% if section.settings.bg_image != blank %}
    .section-{{ section.id }}-padding{
      background:url('{{ section.settings.bg_image | image_url }}');
      background-repeat: no-repeat;
      background-size: cover;
       background-position: center;
    }
  {% endif %}
  .section-{{ section.id }}-padding .nv-order-the-set-wrapper {
        display: grid;
        gap: 5rem;
        grid-template-columns: 1fr 1fr;
        align-items: center;
    }

    .section-{{ section.id }}-padding .nv-order-set-item.image-item img {
        border-radius: {{section.settings.border_radius | default:0 }}px;
    }

    .section-{{ section.id }}-padding .nv-order-set-item.right-item {
        text-align: center;
    }
    .section-{{ section.id }}-padding .custom-nv-order-title{
        font-weight: 700;
        line-height: 100%;
        font-family: var(--font-heading-family);
        letter-spacing: -0.04em;
        font-size:98px;
    }
    .section-{{ section.id }}-padding .custom-nv-order-subtitle{
        font-family: var(--futurafont);
        font-weight: var(--futurafontweightbold);
        line-height: 100%;
        margin-bottom: 20px;
        letter-spacing: -0.04em;
        font-size:34px;
            
    }
   .section-{{ section.id }}-padding .custom-heading-content-block {
       font-family: var(--font-heading-family);
        font-weight: var(--futurafontweightsemi);
        line-height: 100%;
        margin-bottom: 20px;
        letter-spacing: -0.04em;
        font-size:30px;
    }
    .section-{{ section.id }}-padding .custom-nv-order-content{
        line-height: 140%;
        margin-bottom: 20px;
        font-family: var(--futurafont);
        font-weight: var(--futurafontweightsemi);
        letter-spacing: 0.10%;
        font-size:30px;
    }
    .section-{{ section.id }}-padding .custom-nv-order-content p{
        margin-top:0;
        margin-bottom:10px;
    }
    .section-{{ section.id }}-padding .button{
        font-family: var(--font-heading-family);
        font-weight: var(--futurafontweightsemi);
        letter-spacing: 0.10%;
        font-size:30px;
    }
    .section-{{ section.id }}-padding .image--wrapper.custom-image-b-rapper{
        line-height:0;
        max-width:100px;
        margin:0 auto;
        margin-bottom:10px;
    }
     .section-{{ section.id }}-padding .image--wrapper.custom-image-b-rapper img {
        width: 100%;
        height: auto;
        object-fit: cover;
        object-position: center;
    }
@media(max-width:1280px){
    .section-{{ section.id }}-padding .nv-order-the-set-wrapper {
        gap: 3rem;
    }

    .section-{{ section.id }}-padding .nv-order-set-item.right-item {
        padding: 2rem;
        text-align: center;
    }
}
@media(max-width:1024px){
    .section-{{ section.id }}-padding .nv-order-the-set-wrapper {
        gap: 2rem;
    }

    .section-{{ section.id }}-padding .nv-order-set-item.right-item {
        padding: 2rem;
        text-align: center;
    }
   
}
  @media(max-width:749px){
    .section-{{ section.id }}-padding .nv-order-the-set-wrapper {
        gap: 2rem;
         grid-template-columns: 1fr;
    }
     {% if section.settings.bg_image_m != blank %}
        .section-{{ section.id }}-padding{
        background:url('{{ section.settings.bg_image_m | image_url }}');
        background-repeat: no-repeat;
        background-size: cover;
         background-position: center;
        }
    {% endif %}
    .section-{{ section.id }}-padding .image--wrapper.custom-image-b-rapper{
            max-width:50px;
        } 
  }

{% for block in section.blocks %}
     {% case block.type %}
        {% when 'heading' %}
            {% if block.settings.heading != blank %}
                #custom-nv-{{block.id}}-block .custom-nv-order-title{
                    color:{{ block.settings.color }};
                }
              
            {% endif %}
        {% when 'subheading' %}
            {% if block.settings.title != blank %}
                #custom-nv-{{block.id}}-block .custom-nv-order-subtitle{
                    color:{{ block.settings.color }};
                }
                #custom-nv-{{block.id}}-block{
                    {%  if block.settings.block_border_size > 0 %}
                        border:{{ block.settings.block_border_size }}px solid {{block.settings.border_color }};
                    {% endif %}
                    border-radius:{{ block.settings.block_border_radius | default:0 }}px;
                    padding: 30px 15px;
                }
                @media(min-width:750px) and (max-width:1023px){
                        #custom-nv-{{block.id}}-block {
                            padding: 15px;
                        }
                }
                 @media(min-width:1024px) and (max-width:1280px){
                    #custom-nv-{{block.id}}-block {
                            padding: 15px;
                        }
                 }
                @media(max-width:749px){
                        #custom-nv-{{block.id}}-block {
                            padding: 15px;
                        }
                }
                #custom-nv-{{block.id}}-block .button{
                    color:{{ block.settings.button_color }};
                    border:2px solid {{block.settings.button_color }};
                    --buttons-radius: {{block.settings.button_border_radius}}px;
                    --buttons-radius-outset: {{block.settings.button_border_radius}}px;
                    {% if block.settings.button_bg_color != blank %}
                        --color-button: {{ block.settings.button_bg_color.red }},{{ block.settings.button_bg_color.green }},{{ block.settings.button_bg_color.blue }};
                    {%  endif %}
                    {% if block.settings.color != blank %}
                        --color-button-text: {{ block.settings.button_color.red }},{{ block.settings.button_color.green }},{{ block.settings.button_color.blue }};
                    {%  endif %}
                }
            {% endif %}
        {% when 'content' %}
            {% if block.settings.content != blank %}
                #custom-nv-{{block.id}}-block .custom-nv-order-content{
                    color:{{ block.settings.color }};
                }
                #custom-nv-{{block.id}}-block .custom-nv-order-content a{
                    color:{{ block.settings.color }};
                }
                
            {% endif %}
        {% when 'button' %}
            {% if block.settings.title != blank %}
                #custom-nv-{{block.id}}-block .button{
                    color:{{ block.settings.color }};
                    --buttons-radius: {{block.settings.border_radius}}px;
                    --buttons-radius-outset: {{block.settings.border_radius}}px;
                    {% if block.settings.bg_color != blank %}
                        --color-button: {{ block.settings.bg_color.red }},{{ block.settings.bg_color.green }},{{ block.settings.bg_color.blue }};
                    {%  endif %}
                    {% if block.settings.color != blank %}
                        --color-button-text: {{ block.settings.color.red }},{{ block.settings.color.green }},{{ block.settings.color.blue }};
                    {%  endif %}
                }
                
            {% endif %}
        {% when 'spacing' %}
            #custom-nv-{{block.id}}-block {
                display:block;
                padding-bottom:{{block.settings.space_height | default:20 }}px;
            }
            @media(min-width:750px) and (max-width:1023px){
                 {%  if forloop.index == 3 %}
                #custom-nv-{{block.id}}-block {
                padding-bottom:{{block.settings.space_height | times: 0.45 | round: 0 }}px;
                }
                {% endif %}
            }
            @media(min-width:1024px) and (max-width:1280px){
                {%  if forloop.index == 3 %}
                 #custom-nv-{{block.id}}-block {
                    padding-bottom:{{block.settings.space_height | times: 0.45 | round: 0 }}px;
                }
                {% endif %}
            }
            @media(max-width:749px){
            
                #custom-nv-{{block.id}}-block {
                    padding-bottom:{{block.settings.space_height_m | default:20 }}px;
                }
            }
    {% endcase %}
{% endfor %}
@media(min-width:750px) and (max-width:1023px){
    .section-{{ section.id }}-padding .custom-nv-order-title {
        font-size: 40px;
    }

    .section-{{ section.id }}-padding .custom-nv-order-subtitle {
        font-size: 20px;
         margin-bottom: 10px;
    }

    .section-{{ section.id }}-padding .custom-nv-order-content {
        font-size: 18px;
    }

    .section-{{ section.id }}-padding .button{
        font-size: 16px;
        min-height:auto;
        padding:5px 20px;
    }
    .section-{{ section.id }}-padding .custom-heading-content-block{
        font-size: 20px;
    }
    .section-{{ section.id }}-padding .image--wrapper.custom-image-b-rapper{
        max-width:50px;
    } 
    
}
@media(min-width:1024px) and (max-width:1280px){
    .section-{{ section.id }}-padding .image--wrapper.custom-image-b-rapper{
        max-width:75px;
    } 
}
@media(min-width:1024px) and (max-width:1399px){
    .section-{{ section.id }}-padding .custom-nv-order-title {
        font-size: 54px;
    }

    .section-{{ section.id }}-padding .custom-nv-order-subtitle {
        font-size: 24px;
    }

    .section-{{ section.id }}-padding .custom-nv-order-content {
        font-size: 20px;
    }

    .section-{{ section.id }}-padding .button{
        font-size: 20px;
    }
    .section-{{ section.id }}-padding .custom-heading-content-block{
        font-size: 24px;
    }
}
@media(max-width:749px){
    .section-{{ section.id }}-padding .custom-nv-order-title {
        font-size: 32px;
    }

    .section-{{ section.id }}-padding .custom-nv-order-subtitle {
        font-size: 20px;
         margin-bottom: 10px;
    }

    .section-{{ section.id }}-padding .custom-nv-order-content {
        font-size: 16px;
    }

    .section-{{ section.id }}-padding .button{
        font-size: 16px;
         min-height:auto;
        padding:5px 20px;
    }
    .section-{{ section.id }}-padding .custom-heading-content-block{
        font-size: 20px;
    }
}
{%- endstyle -%}


<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="nv-order-the-set-wrapper">
        <div class="nv-order-set-item image-item">
            <div class="image-wrapper">
                <img alt="{{ section.settings.image.alt | default:section.settings.alt_text | escape }}" src="{{ section.settings.image | image_url }}" loading="lazy" width="{{ section.settings.image.width}}" height="{{ section.settings.image.height}}">
            </div>
        </div>
        <div class="nv-order-set-item right-item">
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'image' %}
                        <div class="nv-block-item" id="custom-nv-{{block.id}}-block">
                                <div class="image--wrapper custom-image-b-rapper" >
                                    <img alt="{{ section.settings.image.alt | default:block.settings.alt_text | escape }}" src="{{block.settings.image | image_url }}" width="{{block.settings.image.width }}" height="{{block.settings.image.height }}" loading="lazy">
                                </div>
                        </div>
                    {% when 'heading' %}
                        <div class="nv-block-item" id="custom-nv-{{block.id}}-block">
                            <div class="custom-nv-order-title">{{ block.settings.heading | replace:'__BREAKLINE__','<br/>' }}</div>
                            {% if block.settings.heading_content != blank %}
                                <div class="custom-heading-content-block" {% if block.settings.heading_content_color != blank %} style="color:{{block.settings.heading_content_color}};"{% endif %}>{{block.settings.heading_content }}</div>
                            {% endif %}
                        </div>
                    {% when 'subheading' %}
                        <div class="nv-block-item" id="custom-nv-{{block.id}}-block">
                            <div class="custom-nv-order-subtitle">{{ block.settings.title }}</div>
                            {% if block.settings.button != blank %}
                                <a class="button button--primary" href="{{ block.settings.url }}">{{ block.settings.button }}</a>
                            {% endif %}
                        </div>
                    {% when 'content' %}
                        <div class="nv-block-item" id="custom-nv-{{block.id}}-block">
                            <div class="custom-nv-order-content">{{ block.settings.content }}</div>
                        </div>
                    {% when 'button' %}
                        <div class="nv-block-item" id="custom-nv-{{block.id}}-block">
                            <a class="button button--primary" href="{{ block.settings.url }}">{{ block.settings.title }}</a>
                        </div>
                    {% when 'spacing' %}
                        <div id="custom-nv-{{block.id}}-block"></div>
                {% endcase %}
            {% endfor %}
        </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "NV: Order the set",
  "class": "section nv-order-the-set nv-sections",
  "settings": [
    {
        "type": "image_picker",
        "id": "image",
        "label": "Image",
    },
    {
        "type": "text",
        "id":"alt_text",
        "label": "Image alt"
    },
    {
        "type": "number",
        "id": "border_radius",
        "label": "Image Border radius",
        "default":40
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header_colors.content"
    },        
    {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image"
    },
    {
        "type": "image_picker",
        "id": "bg_image_m",
        "label": "Background image (Mobile)"
    },
     {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "number",
      "id": "padding_top",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
        "type": "image",
        "name":"Image",
        "settings": [
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image",
            },
            {
                "type": "text",
                "id":"alt_text",
                "label": "Image alt"
            }
        ]
    },
    {
        "type":"spacing",
        "name":"Spacing",
        "settings": [
            {
                "type": "number",
                "id": "space_height",
                "label": "Space height",
                "default":40
            },
            {
                "type": "number",
                "id": "space_height_m",
                "label": "Space height (Mobile)",
                "default":32
            },
        ]
    },
    {
        "type": "heading",
        "name":"Heading",
        "settings": [
            {
                "type": "text",
                "id":"heading",
                "label": "Heading",
                "default":"ORDER THE FULL SET"
            },
            {
                "type": "color",
                "id": "color",
                "default":"#000",
                "label": "Color"
            },
            {
                "type": "inline_richtext",
                "id": "heading_content",
                "label": "Heading content",
                "default":"VARITEY SAMPLER 4 PACK"
            },
            {
                "type": "color",
                "id": "heading_content_color",
                "default":"#000",
                "label": "Heading content Color"
            }
        ]
    },
    {
        "type": "subheading",
        "name":"Sub Heading",
        "settings": [
            {
                "type": "text",
                "id":"title",
                "label": "Title",
                "default":"5MG THC PER CAN"
            },
            {
                "type": "color",
                "id": "color",
                "default":"#000",
                "label": "Color"
            },
            {
                "type": "header",
                "content": "Button Settings"
            },
            {
                "type": "text",
                "id":"button",
                "label": "Button"
            },
            {
                "type": "url",
                "id":"url",
                "label": "URL"
            },
            {
                "type": "color",
                "id": "button_bg_color",
                "default":"#000",
                "label": "Button BG Color"
            },
            {
                "type": "color",
                "id": "button_color",
                "default":"#fff",
                "label": "Button Color"
            },
            {
                "type": "number",
                "id": "button_border_radius",
                "label": "Border radius",
                "default":40
            },
            {
                "type": "header",
                "content": "Block Settings"
            },
            {
                "type": "number",
                "id": "block_border_radius",
                "label": "Border radius",
                "default":10
            },
            {
                "type": "number",
                "id": "block_border_size",
                "label": "Border size",
                "default":2
            },
            {
                "type": "color",
                "id": "border_color",
                "default":"#000",
                "label": "Border Color"
            },
        ]
    },
    {
        "type": "content",
        "name":"Content",
        "settings": [
            {
                "type": "richtext",
                "id":"content",
                "label": "Content"
            },
            {
                "type": "color",
                "id": "color",
                "default":"#000",
                "label": "Color"
            }
        ]
    },
    {
        "type": "button",
        "name":"Button",
        "settings": [
            {
                "type": "text",
                "id":"title",
                "label": "Title"
            },
            {
                "type": "url",
                "id":"url",
                "label": "URL"
            },
            {
                "type": "color",
                "id": "bg_color",
                "default":"#000",
                "label": "BG Color"
